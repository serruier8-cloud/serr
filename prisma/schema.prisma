generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model City {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  country   String     @default("Morocco")
  latitude  Float
  longitude Float
  postalPrefix String?
  image     String?
  metaTitleFr String?
  metaTitleAr String?
  metaTitleEn String?
  metaDescFr  String?
  metaDescAr  String?
  metaDescEn  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  locations Location[]
  locksmiths Locksmith[]

  @@index([slug])
}

model Location {
  id            String     @id @default(cuid())
  slug          String
  name          String
  type          LocationType
  arrondissement String?
  parentId      String?
  parent        Location?  @relation("LocationParent", fields: [parentId], references: [id])
  children      Location[] @relation("LocationParent")
  cityId        String
  city          City       @relation(fields: [cityId], references: [id])
  postalCode    String?
  latitude      Float
  longitude     Float
  population    Int?
  metaTitleFr   String?
  metaTitleAr   String?
  metaTitleEn   String?
  metaDescFr    String?
  metaDescAr    String?
  metaDescEn    String?
  introFr       String?
  introAr       String?
  introEn       String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  locksmiths    LocksmithLocation[]
  reviews       Review[]

  @@unique([cityId, slug])
  @@index([cityId])
  @@index([parentId])
}

enum LocationType {
  ARRONDISSEMENT
  QUARTIER
  SOUS_QUARTIER
  LOTISSEMENT
  RESIDENCE
  DOUAR
  BLOC
  SECTEUR
}

model LocksmithService {
  id            String   @id @default(cuid())
  slug          String   @unique
  nameFr        String
  nameAr        String
  nameEn        String
  descriptionFr String?
  descriptionAr String?
  descriptionEn String?
  icon          String?
  metaTitleFr   String?
  metaTitleAr   String?
  metaTitleEn   String?
  metaDescFr    String?
  metaDescAr    String?
  metaDescEn    String?
  introFr       String?
  introAr       String?
  introEn       String?
  priceFrom     Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  locksmiths    ServiceAssignment[]
}

model Locksmith {
  id              String   @id @default(cuid())
  companyName     String
  slug            String   @unique
  email           String?  @unique
  phone           String
  whatsapp        String?
  website         String?
  descriptionFr   String?
  descriptionAr   String?
  descriptionEn   String?
  logo            String?
  photos          String[]
  experience      Int?
  certifications  String[]
  emergencyAvailable Boolean @default(false)
  available247    Boolean  @default(false)
  coverageRadius  Float?   @default(10)
  latitude        Float
  longitude       Float
  address         String?
  cityId          String
  city            City     @relation(fields: [cityId], references: [id])
  isApproved      Boolean  @default(false)
  isFeatured      Boolean  @default(false)
  isVerified      Boolean  @default(false)
  rating          Float    @default(0)
  reviewCount     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  locations       LocksmithLocation[]
  services        ServiceAssignment[]
  reviews         Review[]
  workingHours    WorkingHour[]
}

model LocksmithLocation {
  locksmithId String
  locksmith   Locksmith @relation(fields: [locksmithId], references: [id])
  locationId  String
  location    Location  @relation(fields: [locationId], references: [id])

  @@id([locksmithId, locationId])
}

model ServiceAssignment {
  locksmithId String
  locksmith   Locksmith       @relation(fields: [locksmithId], references: [id])
  serviceId   String
  service     LocksmithService @relation(fields: [serviceId], references: [id])
  priceFrom   Float?
  priceTo     Float?

  @@id([locksmithId, serviceId])
}

model WorkingHour {
  id          String   @id @default(cuid())
  locksmithId String
  locksmith   Locksmith @relation(fields: [locksmithId], references: [id])
  day         Int
  open        String?
  close       String?
  isClosed    Boolean  @default(false)

  @@index([locksmithId])
}

model Review {
  id          String   @id @default(cuid())
  rating      Int
  comment     String?
  authorName  String?
  authorEmail String?
  isApproved  Boolean  @default(false)
  locksmithId String
  locksmith   Locksmith @relation(fields: [locksmithId], references: [id])
  locationId  String?
  location    Location? @relation(fields: [locationId], references: [id])
  createdAt   DateTime @default(now())

  @@index([locksmithId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
}

enum UserRole {
  USER
  ADMIN
  LOCKSMITH
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Translation {
  id        String @id @default(cuid())
  key       String
  locale    String
  value     String

  @@unique([key, locale])
  @@index([key])
}

model Article {
  id        String   @id @default(cuid())
  slug      String   @unique
  titleFr   String
  titleAr   String
  titleEn   String
  excerptFr String?
  excerptAr String?
  excerptEn String?
  contentFr String?
  contentAr String?
  contentEn String?
  imageUrl  String?
  category  String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([category])
  @@index([published])
}
